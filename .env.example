# Copy to .env.local for `npm run dev`; on Vercel set these in Settings → Environment Variables.
# All are server-side only. Never prefix them with VITE_ (that would put them in the browser bundle).

# Naver DataLab Shopping Insight (required for real market data)
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
# openapi (developers.naver.com app, default) | apihub (NAVER API HUB on NAVER Cloud)
NAVER_DATALAB_GATEWAY=openapi

# Supabase (optional: store collected data and cache it across requests)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
MARKET_DATA_CACHE_HOURS=24

# Anthropic (optional: AI blueprint and AI interpretation of collected data)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
